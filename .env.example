# blkChain configuration. Copy to `.env` (gitignored) and edit, or export these
# in your shell. Real environment variables override .env; .env overrides the
# built-in defaults. All paths accept ~ for your home directory.

# --- Data locations ---------------------------------------------------------
# Local MLX models (dense embedder + reranker). Default: <project>/models
# Must contain the embedder (Qwen3-Embedding-0.6B-4bit-DWQ/) and the selected
# reranker (default gte-reranker-modernbert-base-mlx/; or Qwen3-Reranker-0.6B-4bit/).
BLKCHAIN_MODELS_DIR=

# Corpus root (your source documents). Default: <project>/corpus
BLKCHAIN_SOURCES_DIR=

# OWASP WSTG PDF. Default: <sources>/wstg-v4.2.pdf
BLKCHAIN_WSTG_PDF=

# Optional corpora -- omit to skip them entirely:
# SecLists checkout (indexed catalog-only)
BLKCHAIN_SECLISTS_DIR=
# agent skills directory (markdown)
BLKCHAIN_SKILLS_DIR=

# Embedder model served by embed_server. Absolute, or relative to the models dir.
# Must stay 1024-dim (EMBED_DIM) or a new Qdrant collection is required.
# BLKCHAIN_EMBEDDER_PATH=Qwen3-Embedding-0.6B-4bit-DWQ

# Reranker backend: ModernBERT (default), Qwen3, or Jina.
# ModernBERT and Qwen3 use Apache-2.0 models. Jina uses CC-BY-NC-4.0.
# Only the selected backend loads.
# BLKCHAIN_RERANKER_KIND=modernbert
# BLKCHAIN_RERANKER_PATH=      # override the reranker model dir (else the default for the kind)

# --- Services (override only to relocate ports/hosts) -----------------------
# Qdrant HTTP address, read by the Python indexer (index.py, blk add):
# QDRANT_URL=http://127.0.0.1:6333
# Qdrant gRPC address, read by the Go blk client for search and ask:
# QDRANT_GRPC_URL=127.0.0.1:6334
# BLKCHAIN_EMBED_HOST=127.0.0.1
# BLKCHAIN_EMBED_PORT=8100
# BLKCHAIN_COLLECTION=blkchain

# --- LLM (oMLX) -------------------------------------------------------------
# OMLX_BASE_URL=http://127.0.0.1:8000/v1
# OMLX_MODEL=your-local-model-id
# OMLX_API_KEY=            # API key for the local LLM endpoint, if it requires one

# --- Answer/judge tuning -----------------------------------------------------
# Answer-generation caps (read by the `blk` answer loop). Raise ANSWER_MAX_CHUNKS for richer synthesis.
# BLKCHAIN_GRADE_MAX_TOKENS=200
# BLKCHAIN_ANSWER_MAX_TOKENS=700
# BLKCHAIN_CONTEXT_CHARS_PER_CHUNK=1200
# BLKCHAIN_ANSWER_MAX_CHUNKS=4
# Answer sampling (read by the `blk` answer loop; grading stays at temperature 0):
# BLKCHAIN_SYNTH_TEMPERATURE=0.7
# BLKCHAIN_SYNTH_TOP_P=0.95
# BLKCHAIN_SYNTH_TOP_K=64
# BLKCHAIN_SYNTH_PRESENCE_PENALTY=0.5
# Path to the Go blk binary for blkchain.eval.run (else `blk` on PATH):
# BLK_BIN=
# Eval judge context cap (blkchain.eval.run):
# BLKCHAIN_JUDGE_MAX_CONTEXTS=4
# BLKCHAIN_JUDGE_CONTEXT_CHARS=800
# Request body cap (embed_server :8100 default 32 MiB):
# BLKCHAIN_MAX_BODY_BYTES=

# --- Secrets (environment only; never commit real values) -------------------
# TAVILY_API_KEY=          # Tavily key; TAVILY_SETUP_TOKEN is also accepted
# BLKCHAIN_WEB_PROVIDER=auto # auto, duckduckgo, or tavily
# Authorize web answers with blk web on; use blk web off to revoke permission.
