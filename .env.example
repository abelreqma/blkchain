# blkChain configuration. Copy to `.env` (gitignored) and edit, or export these
# in your shell. Real environment variables override .env; .env overrides the
# built-in defaults. All paths accept ~ for your home directory.

# --- Data locations ---------------------------------------------------------
# Local MLX models (dense embedder + reranker). Default: <project>/models
# Must contain: Qwen3-Embedding-0.6B-8bit/ and jina-reranker-v3-4bit-mxfp4/
BLKCHAIN_MODELS_DIR=

# Corpus root (markdown vault, hacktricks, payloads, ...). Default: <project>/corpus
BLKCHAIN_SOURCES_DIR=

# OWASP WSTG PDF. Default: <sources>/wstg-v4.2.pdf
BLKCHAIN_WSTG_PDF=

# Optional corpora -- omit to skip them entirely:
BLKCHAIN_SECLISTS_DIR=      # SecLists checkout (indexed catalog-only)
BLKCHAIN_SKILLS_DIR=        # agent skills directory (markdown)

# --- Services (override only to relocate ports/hosts) -----------------------
# QDRANT_URL=http://127.0.0.1:6333
# BLKCHAIN_EMBED_HOST=127.0.0.1
# BLKCHAIN_EMBED_PORT=8100
# BLKCHAIN_API_HOST=127.0.0.1
# BLKCHAIN_API_PORT=8200
# BLKCHAIN_API_URL=http://127.0.0.1:8200   # read by the `blk` CLI
# BLKCHAIN_COLLECTION=blkchain

# --- LLM (oMLX) -------------------------------------------------------------
# OMLX_BASE_URL=http://127.0.0.1:8000/v1
# OMLX_MODEL=supergemma4-26b-uncensored-mlx-4bit-v2
# OMLX_API_KEY=            # else read from ~/.omlx/settings.json

# --- Secrets (environment only; never commit real values) -------------------
# TAVILY_SETUP_TOKEN=      # enables the kb_answer web fallback
